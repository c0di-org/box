#!/bin/sh
# The only thing in this box that reads the GitHub token.
#
# git asks a helper for a credential instead of asking a person, which is what makes an agent able
# to push at all on a machine with no terminal to type into. It matters just as much that this is
# the *only* reader: with a helper installed, nothing else ever has a reason to open the token
# file, so the token never reaches a command line, a shell history, an environment, or — the one
# that actually lasts — a line of tool output in a session log that is kept on disk.
#
# The protocol: git runs us with one of get/store/erase and writes `key=value` lines on stdin.
# Only `get` has an answer. `store` and `erase` are git offering to manage the credential for us,
# which we decline by succeeding silently: the token's lifetime belongs to Box's connect flow, and
# a failed push must never be able to delete it.
set -eu

TOKEN_FILE="${BOX_GITHUB_TOKEN_FILE:-/workspace/.config/box/github-token}"

# Always drain stdin. git writes the request whatever we intend to do with it, and a helper that
# exits without reading hands git a broken pipe on a path where nothing was actually wrong.
host=''
protocol=''
while IFS= read -r line; do
    [ -n "$line" ] || break
    case "$line" in
        host=*) host="${line#host=}" ;;
        protocol=*) protocol="${line#protocol=}" ;;
    esac
done

[ "${1:-}" = "get" ] || exit 0

# Registered per-host in the box's git config, so this should never see anything else. Checked
# anyway: a helper is a thing that hands out a secret when asked, and "who is asking" is the one
# question it should never take on trust.
case "$host" in
    github.com|"${BOX_GITHUB_HOST:-github.com}") ;;
    *) exit 0 ;;
esac
[ "$protocol" = "https" ] || exit 0

[ -r "$TOKEN_FILE" ] || exit 0
token="$(cat "$TOKEN_FILE")"
[ -n "$token" ] || exit 0

# printf is a shell builtin, so the token is never an argument to a process anything could list.
# x-access-token is GitHub's placeholder username for a token used as a password.
printf 'username=x-access-token\npassword=%s\n' "$token"
