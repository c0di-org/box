<resources>
    <style name="Theme.Box" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/box_background</item>
        <item name="android:windowSplashScreenBackground">@color/box_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_box_splash</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
