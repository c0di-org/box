<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      The guest keyboard's key ticks. A normal permission, granted at install with nothing to
      prompt for — and undeclared until a crash on hardware found it, because the one call it
      guards is reached by laying the keyboard out rather than by pressing a key, so opening the
      computer was enough to take the app down. See `GuestKeyboardView.Feedback`.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Box">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                The only practical way to get a file *into* a box. Everything else about the shared
                folder is a place you navigate to: it appears in the system Files app and in every
                app's Open dialog, but that makes Box a destination and never something you send to.
                Without this filter a screenshot in the user's hand can only be described to the
                agent in prose.

                Deliberately not `*/*`. A share target that offers itself for everything clutters
                every share sheet on the device, and Box has no answer for an arbitrary binary
                beyond putting it on a disk. Widen it when there is a reason.

                `singleTask` above is part of the same feature: it is what makes a share land in the
                conversation the user already has open, rather than starting a second copy of Box on
                top of their own.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!--
            The shared folder, published to Android so it appears in the system Files app and in
            every app's Open/Save dialog. `MANAGE_DOCUMENTS` here is a restriction, not a request:
            it limits direct calls to the system's document machinery, which is the only caller
            that should have them. Box neither holds that permission nor needs it — other apps
            reach a file through the per-URI grant the user makes by picking it.
        -->
        <provider
            android:name=".files.SharedFolderProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
